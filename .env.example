PORT=5001

# Bind address for standalone mode (npm start).
# 0.0.0.0 (default) = all interfaces — for Railway/cPanel/PaaS.
# 127.0.0.1 = only local — recommended on a VPS behind nginx/Cloudflare, so
# the raw port is unreachable from the internet (prevents header spoofing).
# LISTEN_HOST=127.0.0.1

# Strong random secret used to encrypt/sign stream tokens. The built-in
# default and this placeholder are public, so the app REFUSES TO BOOT with
# either — set a real random value. Local dev only: ALLOW_INSECURE_DEFAULT_SECRET=1
PROXY_SECRET=your_32_byte_hex_or_secret_string

# Allowed sites/domains permitted to embed the video player iframe.
# EMBED_MODE unset  -> hard allowlist: any other embedding domain gets a bare
#                      403 (wildcards like *.yumezone.live supported).
# EMBED_MODE=free   -> this list becomes the PARTNER tier: these sites embed
#                      ad-free and get the reserved priority lane. Every other
#                      non-blocked site may embed too, but sees ads and yields
#                      background prefetch first.
# NOTE: sites must NOT strip their Referer (no `Referrer-Policy: no-referrer`)
# or they cannot be identified; unidentified embeds are treated as free tier.
# Direct link visits in a browser tab are always permitted to watch.
ALLOWED_EMBED_DOMAINS=yumezone.live,*.yumezone.live,localhost,127.0.0.1

# Optional hard deny list (comma separated, wildcards supported). Matching
# embedding sites are refused with a bare 403 in every mode. Empty = disabled.
# BLOCKED_EMBED_DOMAINS=bad-site.com,*.spam-example.net

# Whitelisted origins for general CORS requests
ALLOWED_ORIGINS=yumezone.live,localhost,127.0.0.1

# Master switch for ALL per-IP rate limits below. true = on (default).
# false = OFF — allowed domains can send unlimited requests. The embed gate
# and IP-bound tokens still apply regardless of this switch.
RATE_LIMIT_ENABLED=true

# Per-client-IP request budgets (per minute; 0 disables that limit).
# Defaults are deliberately generous so authorized sites' viewers never trip
# them (even behind shared NAT / carrier IPs); they exist as flood protection.
EMBED_RATE_LIMIT_PER_MIN=3000
PROXY_RATE_LIMIT_PER_MIN=30000

# Shared segment tokens: mint viewer-independent /p URLs (no IP claim, expiry
# rounded up to a fixed bucket) so a shared cache (nginx disk cache) can serve
# ONE cached copy of each segment to every viewer. Off = legacy IP-bound tokens.
# Payloads are still AES-GCM encrypted and binding/expiry are still enforced —
# only the identity of the requester is dropped. Tokens minted before a flip
# stay valid until they expire.
SHARED_SEGMENT_TOKENS=false
# Token expiry bucket and grace (seconds). Effective expiry is the end of the
# current bucket + grace, so tokens live between grace and bucket+grace.
# TOKEN_BUCKET_SECONDS=86400
# TOKEN_GRACE_SECONDS=3600

# Prefetch while real clients are streaming. false (default) = legacy hard
# gate: no prefetch at all while any client request is in flight.
# true = prefetch gets its own low-priority budget and bodies always run to
# completion; it never pauses or disarms a client stream.
PREFETCH_UNDER_LOAD=false
# Concurrency/lookahead/warm defaults: 6/15/4 (legacy) or 16/24/8 (under load).
# PREFETCH_MAX_INFLIGHT=16
# PREFETCH_LOOKAHEAD=24
# PREFETCH_WARM_COUNT=8
# Prefetch slots free-tier traffic may never occupy (partner reserve). Free
# prefetch also stops completely while a partner stream is in flight.
# PREFETCH_PARTNER_RESERVE=6
# Prefetch bodies abort if upstream goes silent this long (ms).
# PREFETCH_STALL_MS=20000

# Production warm path: prefetch segments through nginx (not through Node's
# port) so each warm fills the nginx disk cache AND this worker's RAM cache;
# later nginx cache hits never touch Node. Point at nginx's loopback listener.
# PREFETCH_VIA_LOOPBACK=true
# PREFETCH_LOOPBACK_BASE=http://127.0.0.1

# Free embed mode: any non-blocked site may iframe the player (frame-ancestors
# *). ALLOWED_EMBED_DOMAINS become the ad-free partner tier; other sites see
# ads. The embed page itself is not shared-cacheable (it differs per site);
# video segments remain fully shared via SHARED_SEGMENT_TOKENS.
# EMBED_MODE=free

# Redirect ads (free mode only; leave empty to run ad-free).
# Comma-separated direct-link URLs (e.g. Adsterra + Monetag); one is opened
# per browser on the first play click, capped at 1 per 6 h via localStorage.
# AD_DIRECT_URLS=
# Popup-blocked fallback: page shown in a sandboxed 5 s skippable panel over
# the already-playing video. Also no IDs in the repo — set on the server only.
# AD_INTERSTITIAL_URL=

# JSON source endpoints (/api/*/source, /stream/getSources*) hand out direct
# stream URLs. Disabled unless explicitly enabled for a licensed customer.
# SOURCE_API_ENABLED=true

# Downloads (/download, /api/download) hand out full MP4 files and are OFF
# unless explicitly enabled for a licensed deployment.
# DOWNLOAD_ENABLED=true
# DOWNLOAD_RATE_LIMIT_PER_MIN=30
# Library downloads (/download/kaiju/ani/...) stream multi-GB files; the dub
# variant is remuxed with FFmpeg. The quota is shared by all workers.
# FLIX_DOWNLOAD_RATE_LIMIT_PER_MIN=1
# FLIX_DOWNLOAD_DAILY_LIMIT=5
# FLIX_DOWNLOAD_QUOTA_DIR=./data/download-quota

# ---- Admin monitoring (all optional, off by default) -----------------------
# Separate collector process (npm run admin) on 127.0.0.1:5100. The dashboard
# lives at /admin behind nginx; the collector itself is never public.
# Dashboard IP allowlist (comma separated IPs/CIDRs). Empty = loopback only.
# Do NOT add Cloudflare ranges here — nginx resolves the real viewer IP.
# ADMIN_ALLOWED_IPS=203.0.113.10
# ADMIN_PORT=5100
# ADMIN_DATA_DIR=./data/admin
# Shared secret for worker -> collector snapshots. Required to accept them.
# ADMIN_INGEST_TOKEN=change_me_long_random
# Enable worker snapshots (set the SAME vars on all player workers).
# ADMIN_METRICS=1
# ADMIN_SNAPSHOT_MS=30000
# ADMIN_SLOW_MS=2000
# ADMIN_EXPECTED_WORKERS=6
# Non-stream requests slower than ADMIN_SLOW_MS count as slow; segments are
# exempt because they stay open for the whole playback buffer.
# nginx JSON access log tailed by the collector (exact edge traffic).
# ADMIN_EDGE_LOG=/var/log/nginx/mikaza-edge.json.log
# Optional host filter when the log is shared: ADMIN_EDGE_HOSTS=example.com
# nginx stub_status for connection counts: ADMIN_NGINX_STATUS=http://127.0.0.1:8099/nginx_status
# Player beacons for viewers, embed sites, titles and quality.
# ADMIN_TELEMETRY=1
# ADMIN_TELEMETRY_PER_MIN=1200
# ADMIN_LOG_SAMPLE=0.02
# ADMIN_ORIGIN_MAX=4000
# ADMIN_TITLE_MAX=5000
# ADMIN_DB_MAX_MB=512
# ADMIN_RAW_HOURS=24
# ADMIN_MINUTE_DAYS=7
# ADMIN_HOUR_DAYS=90
# ADMIN_DAY_DAYS=365
# ADMIN_EVENT_DAYS=7
# ADMIN_RAW_REQUEST_HOURS=24
# Referer hosts treated as our own site, never as embedders:
# ADMIN_IGNORE_ORIGINS=mikaza.buzz,www.mikaza.buzz
